# Copy to .env and fill in. Collectors whose keys are absent are auto-disabled.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM provider (anthropic | openai | gemini) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Data providers ---
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
CRUNCHBASE_API_KEY=
NEWSAPI_API_KEY=
GITHUB_TOKEN=

# SEC EDGAR needs no key, but requires a descriptive User-Agent with contact email
SEC_EDGAR_USER_AGENT=InvestmentResearchAssistant your-email@example.com

# --- Budgets & timeouts ---
MAX_COST_PER_JOB_USD=5.0
COLLECTOR_TIMEOUT_SECONDS=90
STAGE_TIMEOUT_SECONDS=300

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ira
REDIS_URL=redis://localhost:6379/0
